# ---- Access (set these when the app is reachable beyond localhost, e.g. on Vercel) ----
# Passcode to open the app. Without it, non-localhost devices are locked out.
MISSION_PASSCODE=
# Long random string so sessions survive restarts / multiple instances. Defaults to the passcode if unset.
AUTH_SECRET=

# ---- Database ----
# For hosted/serverless (Vercel): a Turso (libSQL) database so data persists.
# Create one free at https://turso.tech, then paste its URL + token here.
# If unset, the app uses a local SQLite file (./data locally, /tmp on Vercel — ephemeral).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: store the local database + uploads elsewhere (default ./data)
MISSION_DATA_DIR=

# Optional: enables "Write AI summary" in AI Insights (statistics only are sent)
ANTHROPIC_API_KEY=
